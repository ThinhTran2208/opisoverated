FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-runtime.txt requirements-vlm.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-runtime.txt -r requirements-vlm.txt

COPY . .

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "src.inference.vlm_http_api:app", "--host", "0.0.0.0", "--port", "8001"]
