FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FASHION_INFERENCE_DEVICE=cpu \
    FASHION_DETECTION_DEVICE=cpu

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-runtime.txt requirements-detection.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-runtime.txt -r requirements-detection.txt

COPY . .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "src.inference.http_api:app", "--host", "0.0.0.0", "--port", "8000"]
